@import "tailwindcss";

:root {
  /* ========================================
     Professional Design System - Huashu Design Principles
     Based on 8pt grid, refined color palette, and clear hierarchy
     ======================================== */
  
  /* === Color Palette - Refined & Professional === */
  /* Primary: Softer, more sophisticated green */
  --color-primary: #10b981;           /* Emerald 500 - professional green */
  --color-primary-light: #34d399;     /* Emerald 400 */
  --color-primary-dark: #059669;      /* Emerald 600 */
  --color-primary-dim: rgba(16, 185, 129, 0.08);
  --color-primary-subtle: rgba(16, 185, 129, 0.04);
  
  /* Background & Surface - Clean white with subtle warmth */
  --color-background: #fafafa;        /* Neutral 50 - warm white */
  --color-surface: #ffffff;
  --color-surface-elevated: #ffffff;
  
  /* Text Colors - Clear hierarchy */
  --color-foreground: #171717;        /* Neutral 900 - near black */
  --color-foreground-secondary: #404040; /* Neutral 800 */
  --color-muted: #737373;             /* Neutral 500 */
  --color-muted-light: #a3a3a3;       /* Neutral 400 */
  --color-muted-subtle: #d4d4d4;      /* Neutral 300 */
  
  /* Semantic Colors */
  --color-success: #10b981;           /* Emerald 500 */
  --color-success-light: #d1fae5;     /* Emerald 100 */
  --color-success-dim: rgba(16, 185, 129, 0.08);
  --color-error: #ef4444;             /* Red 500 */
  --color-error-light: #fee2e2;       /* Red 100 */
  --color-error-dim: rgba(239, 68, 68, 0.08);
  --color-warning: #f59e0b;           /* Amber 500 */
  --color-warning-light: #fef3c7;     /* Amber 100 */
  --color-warning-dim: rgba(245, 158, 11, 0.08);
  --color-info: #3b82f6;              /* Blue 500 */
  --color-info-light: #dbeafe;        /* Blue 100 */
  --color-info-dim: rgba(59, 130, 246, 0.08);
  
  /* Borders & Dividers */
  --color-border: #e5e5e5;            /* Neutral 200 */
  --color-border-light: #f5f5f5;      /* Neutral 100 */
  --color-border-hover: #10b981;      /* Primary on hover */
  
  /* === Elevation System (based on Material Design) === */
  --shadow-xs: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  --shadow-2xl: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  
  /* Card Styles */
  --card-bg: var(--color-surface);
  --card-shadow: var(--shadow-sm);
  --card-shadow-hover: var(--shadow-lg);
  --card-border: 1px solid var(--color-border);
  
  /* Glassmorphism - Subtle & Modern */
  --glass-bg: rgba(255, 255, 255, 0.85);
  --glass-border: rgba(255, 255, 255, 0.18);
  --glass-blur: 16px;
  --glass-shadow: var(--shadow-lg);
  
  /* === Gradients - Sophisticated & Subtle === */
  --gradient-primary: linear-gradient(135deg, #10b981 0%, #059669 100%);
  --gradient-primary-hover: linear-gradient(135deg, #059669 0%, #047857 100%);
  --gradient-hero: linear-gradient(135deg, #10b981 0%, #14b8a6 50%, #06b6d4 100%);
  --gradient-surface: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  --gradient-subtle: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(6, 182, 212, 0.05) 100%);
  --gradient-glow: radial-gradient(800px circle at var(--glow-x, 50%) var(--glow-y, 50%), rgba(16, 185, 129, 0.06), transparent 60%);
  
  /* === Border Radius - Consistent Scale === */
  --radius-xs: 4px;
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-2xl: 20px;
  --radius-3xl: 24px;
  --radius-full: 9999px;
  
  /* === Typography Scale (based on 1.25 ratio) === */
  --text-xs: 0.75rem;      /* 12px */
  --text-sm: 0.875rem;     /* 14px */
  --text-base: 1rem;       /* 16px */
  --text-lg: 1.125rem;     /* 18px */
  --text-xl: 1.25rem;      /* 20px */
  --text-2xl: 1.5rem;      /* 24px */
  --text-3xl: 1.875rem;    /* 30px */
  --text-4xl: 2.25rem;     /* 36px */
  --text-5xl: 3rem;        /* 48px */
  --text-6xl: 3.75rem;     /* 60px */
  
  /* Font Weights */
  --font-normal: 400;
  --font-medium: 500;
  --font-semibold: 600;
  --font-bold: 700;
  
  /* Line Heights */
  --leading-tight: 1.25;
  --leading-snug: 1.375;
  --leading-normal: 1.5;
  --leading-relaxed: 1.625;
  --leading-loose: 2;
  
  /* Letter Spacing */
  --tracking-tighter: -0.05em;
  --tracking-tight: -0.025em;
  --tracking-normal: 0em;
  --tracking-wide: 0.025em;
  --tracking-wider: 0.05em;
  
  /* === Spacing Scale (8pt grid) === */
  --space-1: 0.25rem;   /* 4px */
  --space-2: 0.5rem;    /* 8px */
  --space-3: 0.75rem;   /* 12px */
  --space-4: 1rem;      /* 16px */
  --space-5: 1.25rem;   /* 20px */
  --space-6: 1.5rem;    /* 24px */
  --space-8: 2rem;      /* 32px */
  --space-10: 2.5rem;   /* 40px */
  --space-12: 3rem;     /* 48px */
  --space-16: 4rem;     /* 64px */
  --space-20: 5rem;     /* 80px */
  
  /* === Transitions - Smooth & Natural === */
  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out-quart: cubic-bezier(0.76, 0, 0.24, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-spring-gentle: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  
  --transition-fast: 100ms var(--ease-out-expo);
  --transition-base: 150ms var(--ease-out-expo);
  --transition-normal: 200ms var(--ease-out-expo);
  --transition-slow: 300ms var(--ease-out-expo);
  --transition-slower: 500ms var(--ease-out-expo);
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html,
body {
  max-width: 100vw;
  overflow-x: hidden;
  font-family: "Work Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

body {
  color: var(--color-foreground);
  background: var(--color-background);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.5;
}

/* 背景光晕效果 */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  background-image: var(--gradient-glow);
  pointer-events: none;
}

a {
  color: inherit;
  text-decoration: none;
}

/* === Card System - Clean & Professional === */
.card {
  background: var(--card-bg);
  border: var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
  transition: all var(--transition-normal);
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: var(--card-shadow-hover);
  border-color: var(--color-primary-light);
}

.card-elevated {
  background: var(--color-surface-elevated);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-xl);
  border: 1px solid var(--color-border-light);
}

/* === 玻璃拟态 === */
.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
}

.glass-subtle {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

/* === 按钮 === */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem 2rem;
  border-radius: var(--radius-md);
  background: var(--gradient-primary);
  color: white;
  font-weight: 600;
  font-size: 1rem;
  letter-spacing: -0.01em;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
  box-shadow: 0 4px 16px rgba(77, 236, 19, 0.35);
  border: none;
  cursor: pointer;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 24px rgba(77, 236, 19, 0.45);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem 2rem;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  color: var(--color-foreground);
  font-weight: 600;
  font-size: 1rem;
  border: 1px solid var(--color-border);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.btn-secondary:hover {
  background: var(--color-background);
  border-color: var(--color-primary);
  color: var(--color-primary-dark);
}

.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  color: var(--color-muted);
  font-weight: 500;
  font-size: 0.875rem;
  background: transparent;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.btn-ghost:hover {
  color: var(--color-foreground);
  background: rgba(0, 0, 0, 0.03);
}

/* === 选项卡片 - Quiz 页面 === */
.option-card {
  background: var(--card-bg);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 1.25rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  transition: all var(--transition-normal);
  cursor: pointer;
  box-shadow: var(--card-shadow);
}

.option-card:hover {
  border-color: var(--color-primary);
  transform: scale(1.02);
  box-shadow: 0 4px 20px rgba(77, 236, 19, 0.15);
}

.option-card.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-dim);
  box-shadow: 0 0 0 3px rgba(77, 236, 19, 0.2);
}

.option-card.correct {
  border-color: var(--color-success);
  background: var(--color-success-dim);
}

.option-card.wrong {
  border-color: var(--color-error);
  background: var(--color-error-dim);
  animation: shake 0.5s ease-in-out;
}

/* === 动画 === */
@keyframes pulse-correct {
  0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
  70% { box-shadow: 0 0 0 20px rgba(34, 197, 94, 0); }
  100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
}

@keyframes pulse-wrong {
  0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
  70% { box-shadow: 0 0 0 20px rgba(239, 68, 68, 0); }
  100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}

@keyframes slide-in-up {
  from { transform: translateY(20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes slide-in-down {
  from { transform: translateY(-20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes slide-in-left {
  from { transform: translateX(20px); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

@keyframes slide-in-right {
  from { transform: translateX(-20px); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

@keyframes fade-in {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes fade-in-up {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-4px); }
  40%, 80% { transform: translateX(4px); }
}

@keyframes glow-pulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.6; }
}

.animate-pulse-correct {
  animation: pulse-correct 0.6s var(--ease-out-expo);
}

.animate-pulse-wrong {
  animation: pulse-wrong 0.6s var(--ease-out-expo);
}

.animate-slide-in-up {
  animation: slide-in-up 0.4s var(--ease-out-expo);
}

.animate-slide-in-down {
  animation: slide-in-down 0.4s var(--ease-out-expo);
}

.animate-slide-in-left {
  animation: slide-in-left 0.4s var(--ease-out-expo);
}

.animate-slide-in-right {
  animation: slide-in-right 0.4s var(--ease-out-expo);
}

.animate-fade-in {
  animation: fade-in 0.4s var(--ease-out-expo);
}

.animate-fade-in-up {
  animation: fade-in-up 0.5s var(--ease-out-expo) both;
}

.animate-float {
  animation: float 4s ease-in-out infinite;
}

.animate-shimmer {
  background: linear-gradient(90deg, transparent 25%, rgba(255,255,255,0.4) 50%, transparent 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
}

/* === 滑块样式 === */
input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 6px;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.08);
  outline: none;
  transition: background var(--transition-fast);
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--gradient-primary);
  cursor: pointer;
  border: 3px solid white;
  box-shadow: 0 2px 8px rgba(77, 236, 19, 0.4);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

input[type="range"]::-webkit-slider-thumb:hover {
  transform: scale(1.1);
  box-shadow: 0 2px 12px rgba(77, 236, 19, 0.5);
}

input[type="range"]::-moz-range-thumb {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--gradient-primary);
  cursor: pointer;
  border: 3px solid white;
  box-shadow: 0 2px 8px rgba(77, 236, 19, 0.4);
}

/* === 滚动条 === */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.08);
  border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 0, 0, 0.15);
}

/* === 选中效果 === */
::selection {
  background: rgba(77, 236, 19, 0.25);
  color: var(--color-foreground);
}

/* === 错开动画延迟 === */
.stagger-1 { animation-delay: 0.05s; }
.stagger-2 { animation-delay: 0.1s; }
.stagger-3 { animation-delay: 0.15s; }
.stagger-4 { animation-delay: 0.2s; }
.stagger-5 { animation-delay: 0.25s; }

/* === 徽章/标签 === */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.badge-primary {
  background: var(--color-primary-dim);
  color: var(--color-primary-dark);
}

.badge-success {
  background: var(--color-success-dim);
  color: var(--color-success);
}

/* === 统计数字 === */
.stat-number {
  font-size: 2.5rem;
  font-weight: 700;
  line-height: 1;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* === 步骤指示器 === */
.step-indicator {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  background: var(--color-primary-dim);
  color: var(--color-primary-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 0.875rem;
}

.step-indicator.active {
  background: var(--gradient-primary);
  color: white;
}
