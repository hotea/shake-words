# =============================================================
# ShakeWords 环境变量配置
# =============================================================
# 复制此文件为 .env.local 并填入你的配置
# cp .env.local.example .env.local

# --- 后端模式 ---
# "mysql"    = 使用 MySQL 数据库（默认）
# "supabase" = 使用 Supabase 云端存储 + 用户认证
NEXT_PUBLIC_BACKEND_TYPE=mysql

# --- MySQL 配置（BACKEND_TYPE=mysql 时需要）---
# 方式一：使用连接字符串
DATABASE_URL=mysql://root:password@127.0.0.1:3306/shakewords
# 方式二：分开配置（优先使用 DATABASE_URL）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=shakewords

# --- Supabase 配置（仅 BACKEND_TYPE=supabase 时需要）---
# 获取方式：https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 认证密钥（BACKEND_TYPE=mysql 时需要）---
# 生成方式: openssl rand -hex 32
AUTH_SECRET=

# --- 子路径部署（可选）---
# 部署到子路径时设置，如 /words
# NEXT_BASE_PATH=/words
# NEXT_PUBLIC_BASE_PATH=/words

# --- SMTP 邮件配置（BACKEND_TYPE=mysql 时需要，用于发送验证码）---
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@wyld.cc
SMTP_PASSWORD=
SMTP_FROM=noreply@wyld.cc
SMTP_SENDER_NAME=ShakeWords
